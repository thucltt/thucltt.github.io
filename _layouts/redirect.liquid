---
<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <title>{{ page.title | default: 'Redirecting…' }}</title>
    <meta http-equiv="refresh" content="0; url={{ page.redirect_to }}">
    <link rel="canonical" href="{{ page.redirect_to }}">
    <script>
      window.location.replace('{{ page.redirect_to }}');
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href="{{ page.redirect_to }}">{{ page.redirect_to }}</a>…
    </p>
  </body>
</html>
